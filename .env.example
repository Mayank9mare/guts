SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token
ALLOWED_USER_ID=U0123456789
BOT_USER_ID=U0987654321
ADMIN_NAME=your name
WHITELISTED_USER_IDS=U111111,U222222
DEFAULT_CWD=/Users/you/claude-workspace
GUEST_CWD=/Users/you/claude-workspace
DEFAULT_MODEL=sonnet

# Optional — where !crawl and the "implement a feature" workflow look for local repo
# checkouts by name. Defaults to ~/repos if unset.
REPOS_BASE_DIR=/Users/you/repos

# Optional — Zenduty on-call auto-ack (!oncall). Leave unset to disable.
# ZENDUTY_TOKEN=
# ZENDUTY_USER_ID=
# ZENDUTY_TEAM_ID=

# Optional — how many days of local trace files (data/traces/*.jsonl) to keep. Pruned on
# startup. The usage.jsonl cost/token rollup is kept forever regardless of this setting.
# TRACE_RETENTION_DAYS=30
