{
  "display_information": {
    "name": "Guts",
    "description": "Control Claude Code terminal sessions from your phone via Slack.",
    "background_color": "#1a1a1a"
  },
  "features": {
    "bot_user": {
      "display_name": "guts",
      "always_online": true
    },
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "channels:history",
        "groups:history",
        "im:history",
        "im:read",
        "im:write",
        "mpim:history",
        "reactions:write",
        "assistant:write",
        "files:read",
        "users:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "assistant_thread_started",
        "assistant_thread_context_changed",
        "message.im",
        "message.groups",
        "message.channels"
      ]
    },
    "interactivity": {
      "is_enabled": false
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
